# ─── Application ───────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
# Public base URL of this API (used to build /api/uploads/... links)
PUBLIC_API_URL=http://localhost:3000
# Swagger UI at /api/docs is on outside production; set true to force it on in production
ENABLE_SWAGGER=false
# Set to true only when running behind a reverse proxy / load balancer (trusts 1 hop of X-Forwarded-For)
TRUST_PROXY=false

# ─── Database (PostgreSQL — docker-compose maps the container to host port 5433) ─
DATABASE_URL="postgresql://hyrr_user:hyrr_password@localhost:5433/hyrr_db?schema=public"

# ─── Redis (optional; falls back to an in-process cache) ──────────────────────
REDIS_HOST=localhost
# docker-compose maps Redis to host port 6380
REDIS_PORT=6380
REDIS_PASSWORD=
# Redis logical DB number (default 0)
REDIS_DB=0

# ─── Auth ──────────────────────────────────────────────────────────────────────
# REQUIRED in production: >= 32 random chars (e.g. `openssl rand -base64 48`).
# The server refuses to start in production with this placeholder.
JWT_SECRET=your_super_secret_jwt_key_here_min_32_chars
# Refresh-token cookie SameSite: lax (default) | strict | none (none forces Secure)
COOKIE_SAMESITE=lax
# Key that encrypts stored 2FA (TOTP) secrets (AES-256-GCM, HKDF-derived). Any long random string,
# e.g. `openssl rand -base64 48`. Defaults to JWT_SECRET; changing it invalidates enrolled 2FA.
TWO_FACTOR_ENCRYPTION_KEY=
# Issuer name shown in authenticator apps
TWO_FACTOR_ISSUER=Hyrr

# ─── Captcha (Cloudflare Turnstile; optional) ─────────────────────────────────
# When set, register / login (after failed attempts) / forgot-password / guest apply require a
# captcha token. Pair with VITE_TURNSTILE_SITE_KEY in the frontends. Empty → captcha disabled.
TURNSTILE_SECRET_KEY=

# ─── Browser origins ───────────────────────────────────────────────────────────
# Comma-separated list used for CORS, the socket gateway and OAuth redirect validation
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175
# Job-seeker app URL: fallback OAuth redirect and base for links in e-mails sent to seekers
FRONTEND_URL=http://localhost:5174
# Recruiter app URL: base for links in e-mails sent to recruiters/admins
RECRUITER_APP_URL=http://localhost:5173

# ─── Google OAuth ──────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# ─── GitHub OAuth (scope: read:user user:email) ────────────────────────────────
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_CALLBACK_URL=http://localhost:3000/api/auth/github/callback

# ─── LinkedIn (Sign In with LinkedIn using OpenID Connect: openid profile email) ─
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
LINKEDIN_CALLBACK_URL=http://localhost:3000/api/auth/linkedin/callback

# ─── AI ────────────────────────────────────────────────────────────────────────
# Set only the key(s) you have. For OpenAI, OPENAI_API_KEY alone is enough.
# Placeholders like "sk-..." / "AIza..." and empty values count as NOT configured;
# with no real key, AI analysis is disabled (aiStatus DISABLED) and chat uses canned tips.
# Model selection: the admin-chosen model (AI settings) if its provider has a key, else
# AI_PROVIDER (openai | anthropic | google) if keyed, else the first keyed provider in the
# order openai → anthropic → google.
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_AI_API_KEY=AIza...
AI_PROVIDER=
# Model ids per provider (also the list admins can choose from)
AI_MODEL_OPENAI=gpt-4o-mini
AI_MODEL_CLAUDE=claude-sonnet-5-5
AI_MODEL_GEMINI=gemini-2.5-flash
# Max LLM calls per featured-jobs computation (results are cached ~1h per user)
AI_FEATURED_MAX_CALLS=5

# ─── Rate limiting (per IP, per minute) ────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=120
# login / register / forgot+reset password / resend verification / 2FA verify / apply
RATE_LIMIT_STRICT_PER_MINUTE=10
# /api/ai/* (defaults to the strict limit)
RATE_LIMIT_AI_PER_MINUTE=10

# ─── Uploads / file storage ───────────────────────────────────────────────────
# local (default; files on disk in UPLOAD_DIR) | s3 (any S3-compatible store: AWS S3, Cloudflare R2, MinIO)
STORAGE_DRIVER=local
# Directory for uploaded files with the local driver (default: ./uploads relative to the working directory)
UPLOAD_DIR=
# Secret for signed document download links (defaults to JWT_SECRET)
UPLOAD_URL_SECRET=
# S3 driver (STORAGE_DRIVER=s3). Without S3_BUCKET the server falls back to local storage.
S3_BUCKET=
# AWS region, or "auto" for R2
S3_REGION=auto
# Custom endpoint for R2 (https://<account>.r2.cloudflarestorage.com) or MinIO (http://minio:9000)
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# true for MinIO / path-style endpoints
S3_FORCE_PATH_STYLE=false
# Optional key prefix inside the bucket, e.g. "uploads/"
S3_PREFIX=

# ─── Virus scanning (ClamAV; optional) ────────────────────────────────────────
# clamd host (INSTREAM over TCP). Empty → uploads are not scanned. With docker compose use
# `CLAMAV_HOST=clamav docker compose --profile security up` (compose sets this variable).
CLAMAV_HOST=
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=15000
# true → accept uploads when clamd is unreachable (default: reject with 503)
CLAMAV_FAIL_OPEN=false

# ─── E-mail (SMTP via nodemailer; optional) ───────────────────────────────────
# Without SMTP_HOST e-mails are not sent: subject, recipient and text (incl. links such as
# verification / reset links) are written to the server log instead.
SMTP_HOST=
# 587 (STARTTLS) or 465 (implicit TLS)
SMTP_PORT=587
# true for port 465; defaults to true only when SMTP_PORT=465
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Hyrr <no-reply@hyrr.local>"

# ─── Error monitoring (Sentry; optional) ──────────────────────────────────────
# Empty → Sentry disabled. Only 5xx errors are reported.
SENTRY_DSN=
# Defaults to NODE_ENV
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=
# 0 disables performance tracing (0.0 – 1.0)
SENTRY_TRACES_SAMPLE_RATE=0

# ─── Trust & safety ───────────────────────────────────────────────────────────
# Unique reports after which a live job is hidden (FLAGGED) pending review
JOB_REPORT_FLAG_THRESHOLD=5

# ─── Seeding ───────────────────────────────────────────────────────────────────
# Demo data (well-known passwords) is refused in production unless this is true
SEED_DEMO_DATA=false

# ─── Job alerts ──────────────────────────────────────────────────────────────
# Daily (08:00 UTC) and weekly (Monday 08:00 UTC) alert digests. Set to false to
# disable the scheduled jobs (instant alerts on publish still run).
ALERT_DIGESTS_ENABLED=true

# ─── Payments (Momentum credits) ─────────────────────────────────────────────
# Every provider is optional: without its key, checkout for it returns 503 PAYMENTS_UNAVAILABLE.
# Payment pages return to ${RECRUITER_APP_URL}/momentum; Chapa calls back ${PUBLIC_API_URL}/api/billing/webhooks/chapa.
# Stripe (card payments in USD, monthly plans). Test keys: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint POST ${PUBLIC_API_URL}/api/billing/webhooks/stripe
# (locally: `stripe listen --forward-to localhost:3000/api/billing/webhooks/stripe` prints a whsec_…)
# Events: checkout.session.completed, checkout.session.async_payment_succeeded,
# checkout.session.async_payment_failed, checkout.session.expired, invoice.paid,
# customer.subscription.updated, customer.subscription.deleted
STRIPE_WEBHOOK_SECRET=
# Frontend only, optional (hosted Checkout does not need it)
VITE_STRIPE_PUBLISHABLE_KEY=
# Chapa (Ethiopian Birr). Test keys: https://dashboard.chapa.co → Settings → API
CHAPA_SECRET_KEY=
# Optional: secret for the x-chapa-signature / chapa-signature HMAC-SHA256 webhook header
CHAPA_WEBHOOK_SECRET=
# Override for tests/mocks only
# CHAPA_API_URL=https://api.chapa.co/v1

# ─── Momentum pricing (credits) ──────────────────────────────────────────────
# SystemSetting.momentumConfig (JSON) overrides these; values are cached for 60 s.
MOMENTUM_PUBLISH_BASE=10
MOMENTUM_FEATURE_COST=25
MOMENTUM_FEATURE_DAYS=14
MOMENTUM_AI_RERUN_COST=2
MOMENTUM_SIGNUP_BONUS=20
# Comma-separated job category slugs or names that cost ×1.2 to publish (empty = none)
MOMENTUM_PREMIUM_CATEGORIES=

# ─── Background jobs (BullMQ) ────────────────────────────────────────
# With REDIS_HOST set, jobs (e-mail, AI scoring, alerts, search indexing, maintenance) run on
# BullMQ; without it they run in-process with the same retries. "inline" forces in-process.
QUEUE_DRIVER=
# false = this instance only enqueues (API-only replica); run at least one instance with workers.
QUEUE_WORKER=true
# Per-queue worker concurrency, e.g. QUEUE_CONCURRENCY_AI_SCORING=2 (default 2; others 5)
# QUEUE_CONCURRENCY_EMAIL=5

# ─── Search (Meilisearch, optional) ──────────────────────────────────
# Unset = public job search uses Postgres. docker compose sets MEILI_HOST=http://meilisearch:7700.
MEILI_HOST=
MEILI_MASTER_KEY=
MEILI_JOBS_INDEX=jobs
MEILI_TIMEOUT_MS=2000

# ─── Semantic matching (optional; uses OPENAI_API_KEY, costs OpenAI credit) ──
# Blends embedding similarity into "For you" scores. Off automatically without an OpenAI key.
EMBEDDINGS_ENABLED=true
EMBEDDINGS_MODEL=text-embedding-3-small
# Test hook only: point embeddings at a fake OpenAI-compatible server.
# OPENAI_BASE_URL=
