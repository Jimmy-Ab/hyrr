datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  SEEKER
  RECRUITER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  PENDING
}

enum CompanyStatus {
  VERIFIED
  PENDING
  SUSPENDED
}

enum JobStatus {
  ACTIVE
  CLOSED
  DRAFT
  FLAGGED
}

enum ApplicationStatus {
  SAVED
  SOURCED   // a recruiter reached out from talent search; the seeker hasn't answered yet
  APPLIED
  IN_PROCESS
  INTERVIEWING
  OFFER
  ARCHIVED
  WITHDRAWN
}

enum DocType {
  RESUME
  COVER
  CERT
  PORTFOLIO
  OTHER
}

enum EventType {
  INTERVIEW
  DEADLINE
  OFFER
  OTHER
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  REMOTE
}

enum CompanyMemberRole {
  OWNER
  RECRUITER
  HIRING_MANAGER
  VIEWER
}

enum ApplicationSource {
  DIRECT          // a signed-in job seeker applied
  GUEST           // applied without an account
  RECRUITER_ADDED // added manually by the hiring team
  OUTREACH        // a recruiter contacted an opted-in seeker from talent search
}

enum AlertFrequency {
  INSTANT
  DAILY
  WEEKLY
}

enum NotificationType {
  APPLICATION
  INTERVIEW
  MESSAGE
  OFFER
  JOB_ALERT
  SYSTEM
}

enum NotificationAction {
  APPLICATIONS
  DISCOVER
  MESSAGES
  CALENDAR
}

// ==========================================
// 1. Core Authentication & Users
// ==========================================
model User {
  id           String      @id @default(uuid())
  email        String      @unique
  passwordHash String?     // Nullable to support pure OAuth users
  name         String
  avatar       String
  role         UserRole    @default(SEEKER)
  status       UserStatus  @default(ACTIVE)
  joinedAt     DateTime    @default(now())
  lastLogin    DateTime    @default(now())
  /// Last authenticated activity (login or API use, updated at most hourly); powers active-user analytics.
  lastActiveAt DateTime?

  // Account security
  emailVerifiedAt        DateTime?
  tokenVersion           Int       @default(0) // bump to revoke every session (password reset/change)
  twoFactorEnabled       Boolean   @default(false)
  twoFactorSecret        String?   // TOTP secret, AES-256-GCM encrypted at rest
  twoFactorRecoveryCodes String[]  // sha256 hashes of one-time recovery codes

  // OAuth Credentials (Google, LinkedIn, GitHub)
  googleId     String?     @unique
  githubId     String?     @unique
  linkedinId   String?     @unique

  // Relations
  companyId    String?
  company      Company?    @relation(fields: [companyId], references: [id])
  seekerProfile SeekerProfile?
  documents    Document[]
  applications Application[]
  notifications Notification[]
  postedJobs   Job[]       @relation("RecruiterJobs")
  auditLogs    AuditLog[]
  payments     Payment[]
  creditWallet       CreditWallet?       @relation("UserCreditWallet")
  creditTransactions CreditTransaction[] @relation("UserCreditTransactions")
  setting      UserSetting?
  sentMessages Message[]   @relation("SentMessages")
  receivedMessages Message[] @relation("ReceivedMessages")
  calendarEvents CalendarEvent[]
  companyMemberships CompanyMember[]
  invitesSent        CompanyInvite[]      @relation("InviteSender")
  interviewInvites   InterviewInvite[]    @relation("InterviewInviteCreator")
  scorecards         Scorecard[]
  offersCreated      Offer[]              @relation("OfferCreator")
  companyBlocks      CompanyBlock[]
  externalApplications ExternalApplication[]
  externalJobApplies ExternalJobApply[]
  resumeTailorings   ResumeTailoring[]
  mockInterviews     MockInterview[]
  skillAssessments   SkillAssessment[]
  aiFeedback         AiFeedback[]
  joinRequests       CompanyJoinRequest[] @relation("JoinRequester")
  joinDecisions      CompanyJoinRequest[] @relation("JoinDecider")
  conversationStates ConversationState[]
  authTokens         AuthToken[]
  jobAlerts     JobAlert[]
  savedSearches  SavedSearch[]
  @@index([joinedAt])
  @@index([lastActiveAt])
}

model Company {
  id          String        @id @default(uuid())
  name        String
  logo        String        // Simple letter or URL
  color       String        @default("purple")
  status      CompanyStatus @default(PENDING)
  plan        String        @default("Starter") // Starter, Pro, Enterprise
  verified       Boolean   @default(false) // a verified recruiter e-mail matches the company website domain
  verifiedDomain String?
  verifiedAt     DateTime?
  country     String
  city        String?
  website     String?
  description String?       @db.Text
  industry    String?
  joinedAt    DateTime      @default(now())

  // Relations
  members     User[]
  teamMembers CompanyMember[]
  invites      CompanyInvite[]
  joinRequests CompanyJoinRequest[]
  blockedBy    CompanyBlock[]
  stats        CompanyStats?
  jobs        Job[]
  wallet       CreditWallet?
  transactions CreditTransaction[]
  payments     Payment[]
  subscription Subscription?
  @@index([joinedAt])
}

// ==========================================
// 2. Seeker Profiles, Portfolios & Interests
// ==========================================
model SeekerProfile {
  id                 String     @id @default(uuid())
  userId             String     @unique
  user               User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  title              String
  location           String
  website            String?
  github             String?    // Public URL link
  linkedin           String?    // Public URL link
  bio                String?    @db.Text
  expectedSalary     String? // display text, derived from the structured range below
  expectedSalaryMin      Int?
  expectedSalaryMax      Int?
  expectedSalaryCurrency String?
  expectedSalaryPeriod   SalaryPeriod?
  preferredType      String?    // Full Time, Part Time, Contract, Remote
  availability       String?    // e.g. "2 weeks notice"
  preferredLocations String[]
  visibility         String     @default("public") // public, private
  /// Opt-in: recruiters can find this profile in talent search and reach out (off by default)
  openToRecruiters   Boolean    @default(false)
  openToRecruitersAt DateTime?
  skills             String[]
  languages          String[]
  phone              String?
  yearsOfExperience  String?
  updatedAt          DateTime   @updatedAt

  // Relations
  experiences        WorkExperience[]
  educations         Education[]
  interests          JobCategory[]    @relation("SeekerInterests")
}

model WorkExperience {
  id              String        @id @default(uuid())
  profileId       String
  profile         SeekerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  role            String
  company         String
  duration        String // display text, derived from the dates below
  startDate       DateTime? // first day of the start month
  endDate         DateTime? // null with current = true
  current         Boolean       @default(false)
  desc            String?       @db.Text
}

model Education {
  id              String        @id @default(uuid())
  profileId       String
  profile         SeekerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  school          String
  degree          String
  duration        String // display text, derived from the years below
  startYear       Int?
  endYear         Int?
}

enum SalaryPeriod {
  YEAR
  MONTH
  HOUR
}

model Document {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  type      DocType  @default(RESUME)
  size      String
  version   Int      @default(1)
  active    Boolean  @default(true)
  url       String   // S3/Cloud Storage link
  createdAt DateTime @default(now())
}

// ==========================================
// 3. Job Fields & Categories
// ==========================================
model JobCategory {
  id             String          @id @default(uuid())
  name           String          @unique // e.g. "Software Development", "Accounting and Finance"
  slug           String          @unique // e.g. "software-development", "accounting-finance"
  jobs           Job[]
  seekerProfiles SeekerProfile[] @relation("SeekerInterests")
}

// ==========================================
// 4. Job Openings
// ==========================================
model Job {
  id            String      @id @default(uuid())
  companyId     String
  company       Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  recruiterId   String
  postedBy      User        @relation("RecruiterJobs", fields: [recruiterId], references: [id])
  categoryId    String
  category      JobCategory @relation(fields: [categoryId], references: [id])
  
  title         String
  location      String
  type          EmploymentType
  salary        String? // display text, derived from the structured range below
  salaryMin      Int?
  salaryMax      Int?
  salaryCurrency String? // ISO 4217, e.g. USD, ETB
  salaryPeriod   SalaryPeriod?
  status        JobStatus   @default(ACTIVE)
  color         String      @default("purple")
  description   String      @db.Text
  requirements  String[]
  skills        String[]
  /// Working languages (normalised names, e.g. "English"); existing jobs default to English
  languages     String[]    @default(["English"])
  benefits      String[]
  featured      Boolean     @default(false) // currently featured (kept in sync with featuredUntil)
  featuredUntil DateTime?
  /// Set when an admin removes the job (moderation); the recruiter can't reopen it.
  removedAt     DateTime?
  removedReason String?
  /// Scorecard criteria for this job; empty = the default four
  scorecardCompetencies String[] @default([])
  /// Grey-area scam signals found at publish (job-risk.ts); >= threshold → FLAGGED for review
  riskScore     Int?
  riskReasons   String[] @default([])
  resumeTailorings ResumeTailoring[]
  publishedAt   DateTime? // first time the job went live (publishing is charged once)
  remote        Boolean     @default(false)
  momentumCost  Int         @default(0) // Momentum credits charged when it was published
  createdAt     DateTime    @default(now())

  // Relations
  applications  Application[]
  screeningQuestions ScreeningQuestion[]
  @@index([publishedAt])
}

// ==========================================
// 5. Job Applications & Pipeline (Consolidated Candidates)
// ==========================================
model Application {
  id                 String            @id @default(uuid())
  jobId              String
  job                Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  userId             String?
  user               User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  
  // Applicant details (cached from profile or filled out manually)
  name               String
  email              String
  phone              String?
  title              String
  location           String
  coverLetter        String?           @db.Text
  resumeUrl          String?
  
  // Pipeline tracking
  status             ApplicationStatus @default(APPLIED)
  source             ApplicationSource @default(DIRECT)
  tag                String?           // Substatus e.g. "Technical Test", "Offer Sent", "Not a fit"
  seekerBookmarked   Boolean           @default(false)
  recruiterBookmarked Boolean          @default(false)
  appliedAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  
  // AI score for this application matching
  aiScore            Int?                // Match rating from 0 to 100; null = not scored yet
  aiSummary          String?           @db.Text    // Explanation generated by the AI
  aiAnalysis         Json?             // Structured report: recommendation, matched/missing skills, strengths, concerns...
  aiStatus           String?           // PENDING | DONE | FAILED | DISABLED
  aiModel            String?           // Model that produced the current analysis
  aiScoredAt         DateTime?
  aiError            String?           @db.Text
  
  // Offer info if extended
  offerAmount        String?

  // Relations
  messages           Message[]
  calendarEvents     CalendarEvent[]
  interviewInvites   InterviewInvite[]
  scorecards         Scorecard[]
  offers             Offer[]
  aiFeedback         AiFeedback[]
  labels             ApplicationLabel[]
  recruiterNotes     ApplicationNote[]
  answers            ScreeningAnswer[]
  stageEvents        ApplicationStageEvent[]
  conversationStates ConversationState[]
  @@index([appliedAt])
}

// ==========================================
// 6. Communications (Direct Messages)
// ==========================================
model Message {
  id            String      @id @default(uuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  senderId      String?
  sender        User?       @relation("SentMessages", fields: [senderId], references: [id], onDelete: SetNull)
  receiverId    String?
  receiver      User?       @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: SetNull)
  senderType    UserRole
  text          String      @db.Text
  createdAt     DateTime    @default(now())
  read          Boolean     @default(false)
  // Client-generated id so a retried send (socket timeout -> REST) is idempotent.
  clientId      String?

  @@unique([senderId, clientId])
  @@index([applicationId, createdAt])
  @@index([createdAt])
}

// Per-user conversation state: read position and "delete for me".
model ConversationState {
  id            String      @id @default(uuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt    DateTime?
  clearedAt     DateTime?
  updatedAt     DateTime    @updatedAt

  @@unique([applicationId, userId])
  @@index([userId])
}

// ==========================================
// 7. Scheduling (Interviews & Deadlines)
// ==========================================
model CalendarEvent {
  id            String       @id @default(uuid())
  applicationId String?
  application   Application? @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  userId        String?
  user          User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  title         String
  startTime     DateTime
  endTime       DateTime?
  type          EventType    @default(INTERVIEW)
  meetingUrl    String?
  location      String?
  notes         String?      @db.Text
  createdAt     DateTime     @default(now())
}

// ==========================================
// 8. Settings & Platform Administration
// ==========================================
model UserSetting {
  id                   String   @id @default(uuid())
  userId               String   @unique
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailNotifications   Boolean  @default(true)
  smsNotifications     Boolean  @default(false)
  marketingEmails      Boolean  @default(false)
  applicationUpdates   Boolean  @default(true)
  interviewReminders   Boolean  @default(true)
  offerNotifications   Boolean  @default(true)
  messageNotifications Boolean  @default(true)
  jobRecommendations   Boolean  @default(true)
  weeklyDigest         Boolean  @default(false)
  profilePublic        Boolean  @default(true)
  resumeVisible        Boolean  @default(true)
  showActivity         Boolean  @default(false)
  theme                String   @default("light")
  updatedAt            DateTime @updatedAt
}
model SystemSetting {
  id            String   @id @default("global-settings")
  activeModel   String   @default("gemini-2.5-flash")
  momentumConfig Json? // Momentum pricing overrides (publish base, multipliers, feature cost/days, AI re-run cost)
  temperature   Float    @default(0.2)
  systemPrompt  String   @db.Text
  updatedAt     DateTime @updatedAt
}

model Notification {
  id         String           @id @default(uuid())
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  title      String
  type       NotificationType @default(SYSTEM)
  actionView NotificationAction?
  targetId   String? // e.g. applicationId of the conversation a message notification belongs to
  read       Boolean          @default(false)
  createdAt  DateTime         @default(now())
}

// A purchase through Stripe or Chapa. Credits are granted exactly once, when the provider
// confirms the payment (idempotent on providerRef).
model Payment {
  id          String          @id @default(uuid())
  companyId   String? // null = a seeker's own purchase (userId)
  company     Company?        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  provider    PaymentProvider
  providerRef String          @unique // Stripe Checkout Session id / Chapa tx_ref
  kind        PaymentKind     @default(CREDIT_PACK)
  packageId   String?
  package     CreditPackage?  @relation(fields: [packageId], references: [id], onDelete: SetNull)
  credits     Int             @default(0)
  amount      Int // minor units (cents / santim)
  currency    String
  status      PaymentStatus   @default(PENDING)
  description String
  metadata    Json?
  paidAt      DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([companyId, createdAt])
  @@index([userId, createdAt])
  @@index([paidAt])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String
  target    String
  details   String   @db.Text
  /// Structured context (reason, before/after values).
  meta      Json?
  ip        String
  severity  String
  createdAt DateTime @default(now())
  @@index([createdAt])
  @@index([userId, createdAt])
}

// ==========================================
// 9. Recruiter collaboration and hiring workflow
// ==========================================
model CompanyMember {
  id        String            @id @default(uuid())
  companyId String
  company   Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      CompanyMemberRole @default(RECRUITER)
  createdAt DateTime          @default(now())
  @@unique([companyId, userId])
}

/// Owner invites a colleague by e-mail; accepted through a one-time link (stored as a sha256 hash).
model CompanyInvite {
  id          String            @id @default(uuid())
  companyId   String
  company     Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  email       String
  role        CompanyMemberRole @default(RECRUITER)
  tokenHash   String            @unique
  invitedById String?
  invitedBy   User?             @relation("InviteSender", fields: [invitedById], references: [id], onDelete: SetNull)
  createdAt   DateTime          @default(now())
  expiresAt   DateTime
  acceptedAt  DateTime?
  declinedAt  DateTime?
  revokedAt   DateTime?
  @@index([companyId, email])
}

enum JoinRequestStatus {
  PENDING
  APPROVED
  DECLINED
  CANCELED
}

/// A recruiter whose e-mail domain matches a verified company asks to join it.
model CompanyJoinRequest {
  id          String            @id @default(uuid())
  companyId   String
  company     Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId      String
  user        User              @relation("JoinRequester", fields: [userId], references: [id], onDelete: Cascade)
  status      JoinRequestStatus @default(PENDING)
  createdAt   DateTime          @default(now())
  decidedById String?
  decidedBy   User?             @relation("JoinDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt   DateTime?
  @@index([companyId, status])
  @@index([userId, status])
}

enum InterviewInviteStatus {
  OPEN
  BOOKED
  CANCELED
}

/// Recruiter offers interview times; the candidate books one in the seeker app.
model InterviewInvite {
  id            String                @id @default(uuid())
  applicationId String
  application   Application           @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  createdById   String?
  createdBy     User?                 @relation("InterviewInviteCreator", fields: [createdById], references: [id], onDelete: SetNull)
  title         String
  durationMin   Int
  location      String?
  meetingUrl    String?
  note          String?               @db.Text
  status        InterviewInviteStatus @default(OPEN)
  /// CalendarEvent created when the candidate books a slot
  eventId       String?               @unique
  createdAt     DateTime              @default(now())
  slots         InterviewSlot[]
  @@index([applicationId, status])
}

model InterviewSlot {
  id        String          @id @default(uuid())
  inviteId  String
  invite    InterviewInvite @relation(fields: [inviteId], references: [id], onDelete: Cascade)
  startTime DateTime
  endTime   DateTime
  bookedAt  DateTime?
  @@index([inviteId])
}

enum ScorecardRecommendation {
  STRONG_YES
  YES
  NEUTRAL
  NO
  STRONG_NO
}

/// One interviewer's structured evaluation of an application (blind until they submit).
model Scorecard {
  id             String                  @id @default(uuid())
  applicationId  String
  application    Application             @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  interviewerId  String
  interviewer    User                    @relation(fields: [interviewerId], references: [id], onDelete: Cascade)
  recommendation ScorecardRecommendation
  overallNotes   String                  @db.Text
  submittedAt    DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  ratings        ScorecardRating[]
  @@unique([applicationId, interviewerId])
}

model ScorecardRating {
  id          String    @id @default(uuid())
  scorecardId String
  scorecard   Scorecard @relation(fields: [scorecardId], references: [id], onDelete: Cascade)
  competency  String
  score       Int
  notes       String?   @db.Text
  @@index([scorecardId])
}

enum OfferStatus {
  SENT
  ACCEPTED
  DECLINED
  WITHDRAWN
}

/// Formal job offer; the candidate accepts in the app with a typed-name signature (audited).
model Offer {
  id               String       @id @default(uuid())
  applicationId    String
  application      Application  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  createdById      String?
  createdBy        User?        @relation("OfferCreator", fields: [createdById], references: [id], onDelete: SetNull)
  jobTitle         String
  baseSalary       Int
  salaryCurrency   String
  salaryPeriod     SalaryPeriod
  bonusAmount      Int?
  equityPercentage Float?
  startDate        DateTime
  expiresAt        DateTime
  benefits         String[]     @default([])
  message          String?      @db.Text
  status           OfferStatus  @default(SENT)
  signatureName    String?
  signedAt         DateTime?
  signedIp         String?
  declineReason    String?      @db.Text
  respondedAt      DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  @@index([applicationId, status])
}

/// A seeker hides their profile from a company's talent search (and its outreach).
model CompanyBlock {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@unique([userId, companyId])
}

enum ExternalStage {
  BOOKMARKED
  APPLIED
  INTERVIEWING
  OFFER
  REJECTED
}

/// A job the seeker tracks outside Hyrr (LinkedIn, company sites…), shown next to Hyrr applications.
model ExternalApplication {
  id        String        @id @default(uuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  company   String
  title     String
  url       String?
  location  String?
  stage     ExternalStage @default(APPLIED)
  notes     String?       @db.Text
  appliedAt DateTime?
  /// Set when the seeker applied to a job from the web through Hyrr (auto-tracked)
  externalJobId String?
  externalJob   ExternalJob? @relation(fields: [externalJobId], references: [id], onDelete: SetNull)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  @@index([userId, stage])
}

enum ExternalJobSource {
  ADZUNA
  JOOBLE
  REMOTIVE
  ARBEITNOW
}

/// Job aggregated from a licensed job API; applying opens the original posting.
model ExternalJob {
  id             String            @id @default(uuid())
  source         ExternalJobSource
  sourceId       String
  title          String
  company        String
  /// Company logo URL supplied by the provider (https only; null when the provider has none)
  companyLogo    String?
  location       String?
  remote         Boolean           @default(false)
  description    String?           @db.Text
  url            String
  salaryMin      Int?
  salaryMax      Int?
  salaryCurrency String?
  employmentType String?
  category       String?
  postedAt       DateTime?
  fetchedAt      DateTime          @default(now())
  /// Hidden after this (refreshed on every sync while the source still lists it)
  expiresAt      DateTime
  active         Boolean           @default(true)
  applies        ExternalJobApply[]
  tracked        ExternalApplication[]
  @@unique([source, sourceId])
  @@index([active, postedAt])
}

/// A seeker paid to open an external job (once per job; reopening is free).
model ExternalJobApply {
  id            String      @id @default(uuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  externalJobId String
  externalJob   ExternalJob @relation(fields: [externalJobId], references: [id], onDelete: Cascade)
  credits       Int
  createdAt     DateTime    @default(now())
  @@unique([userId, externalJobId])
}

/// AI comparison of the seeker's CV/profile with one Hyrr job (kept so reopening is free).
model ResumeTailoring {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId     String
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  result    Json
  model     String?
  cvUsed    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([userId, jobId])
}

enum MockInterviewStatus {
  IN_PROGRESS
  COMPLETED
}

/// AI practice interview for a job: 5 questions, STAR feedback per answer, final summary.
model MockInterview {
  id        String              @id @default(uuid())
  userId    String
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId     String?
  jobTitle  String
  company   String?
  questions Json
  answers   Json                @default("[]")
  summary   Json?
  status    MockInterviewStatus @default(IN_PROGRESS)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  @@index([userId, createdAt])
}

/// Multiple-choice question bank per skill (answers never leave the server).
enum SkillLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

model SkillQuestion {
  id           String   @id @default(uuid())
  skill        String
  /// Shared bank per skill and level; existing questions were written at intermediate level
  difficulty   SkillLevel @default(INTERMEDIATE)
  question     String   @db.Text
  options      String[]
  correctIndex Int
  explanation  String?  @db.Text
  active       Boolean  @default(true)
  /// Seeker reports; at 3 the question is deactivated and never sampled again
  reportCount  Int      @default(0)
  reports      SkillQuestionReport[]
  createdAt    DateTime @default(now())
  @@index([skill, active])
  @@index([skill, difficulty, active])
}

/// One report per seeker per question ("Report this question" in a test).
model SkillQuestionReport {
  id         String        @id @default(uuid())
  questionId String
  question   SkillQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  userId     String
  reason     String?
  createdAt  DateTime      @default(now())
  @@unique([questionId, userId])
}

/// Whether a skill can be assessed (cached once per skill for everyone; key = lower-case name).
model SkillEligibility {
  skill     String   @id
  label     String
  testable  Boolean
  reason    String?
  checkedAt DateTime @default(now())
}

/// One timed attempt; passing (>= 80%) is a "Verified" badge until validUntil.
model SkillAssessment {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill       String
  difficulty  SkillLevel @default(INTERMEDIATE)
  questionIds String[]
  answers     Int[]     @default([])
  score       Int?
  passed      Boolean   @default(false)
  startedAt   DateTime  @default(now())
  expiresAt   DateTime
  submittedAt DateTime?
  validUntil  DateTime?
  @@index([userId, skill])
}

/// Nightly responsiveness stats (last 30 days) behind the "Fast Responder" badge.
model CompanyStats {
  companyId                String   @id
  company                  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  applications30d          Int      @default(0)
  medianFirstResponseHours Float?
  reviewRate30d            Float?
  ghostRate30d             Float?
  fastResponder            Boolean  @default(false)
  computedAt               DateTime @default(now())
  @@index([fastResponder])
}

/// One AI call (all features). Tokens and cost are estimates from text length and the price table.
model AiUsage {
  id           String   @id @default(uuid())
  provider     String
  model        String
  feature      String
  ok           Boolean
  latencyMs    Int
  inputTokens  Int
  outputTokens Int
  costUsd      Float?
  createdAt    DateTime @default(now())
  @@index([createdAt])
}

/// Recruiter thumbs up/down on an AI candidate analysis (drift signal for admins).
model AiFeedback {
  id            String      @id @default(uuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  helpful       Boolean
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  @@unique([applicationId, userId])
  @@index([createdAt])
}

model ScreeningQuestion {
  id        String   @id @default(uuid())
  jobId     String
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  question  String   @db.Text
  required  Boolean  @default(false)
  position  Int      @default(0)
  createdAt DateTime @default(now())
  answers   ScreeningAnswer[]
}

model ScreeningAnswer {
  id         String            @id @default(uuid())
  applicationId String
  application Application       @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  questionId String
  question   ScreeningQuestion  @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answer     String             @db.Text
  @@unique([applicationId, questionId])
}

model CandidateLabel {
  id        String   @id @default(uuid())
  companyId String
  name      String
  color     String   @default("purple")
  createdAt DateTime @default(now())
  applications ApplicationLabel[]
  @@unique([companyId, name])
}

model ApplicationLabel {
  applicationId String
  application   Application    @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  labelId       String
  label         CandidateLabel @relation(fields: [labelId], references: [id], onDelete: Cascade)
  @@id([applicationId, labelId])
}

model ApplicationNote {
  id            String      @id @default(uuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  authorId      String
  body          String      @db.Text
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @default(now()) @updatedAt

  @@index([applicationId, createdAt])
}

model ApplicationStageEvent {
  id            String            @id @default(uuid())
  applicationId String
  application   Application       @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  fromStatus    ApplicationStatus?
  toStatus      ApplicationStatus
  actorId       String?
  createdAt     DateTime          @default(now())
  @@index([toStatus, createdAt])
}


// ==========================================
// 10. Seeker discovery, trust and billing foundations
// ==========================================
model JobAlert {
  id         String         @id @default(uuid())
  userId     String
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  keywords   String[]
  locations  String[]
  jobTypes   String[]
  minSalary  String?
  remoteOnly Boolean        @default(false)
  frequency  AlertFrequency @default(DAILY)
  active     Boolean        @default(true)
  lastSentAt DateTime? // last digest sent; digests only include jobs posted after it
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
}

model SavedSearch {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  query     String?
  filters   Json
  createdAt DateTime @default(now())
}

model JobReport {
  id          String   @id @default(uuid())
  jobId       String
  reporterId  String
  reason      String
  details     String?  @db.Text
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())
  @@unique([jobId, reporterId])
}

model Subscription {
  id                     String             @id @default(uuid())
  companyId              String             @unique
  company                Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  plan                   String             @default("STARTER") // Plan.code
  status                 SubscriptionStatus @default(ACTIVE)
  provider               PaymentProvider?
  providerCustomerId     String?
  providerSubscriptionId String?            @unique
  currentPeriodEnd       DateTime?
  cancelAtPeriodEnd      Boolean            @default(false)
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
}

// One-time tokens for e-mail verification and password reset (only the hash is stored).
model AuthToken {
  id        String        @id @default(uuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      AuthTokenType
  tokenHash String        @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())

  @@index([userId, type])
}

enum AuthTokenType {
  VERIFY_EMAIL
  RESET_PASSWORD
}

// ─── Momentum credits ────────────────────────────────────────────────────────

enum PaymentProvider {
  STRIPE
  CHAPA
}

enum PaymentKind {
  CREDIT_PACK
  SUBSCRIPTION
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
}

enum CreditTransactionType {
  PURCHASE
  SIGNUP_BONUS
  PLAN_GRANT
  JOB_PUBLISH
  JOB_FEATURE
  AI_ANALYSIS
  APPLICATION
  OUTREACH
  EXTERNAL_APPLY
  AI_SEEKER_TOOL
  REFUND
  ADJUSTMENT
}

// One wallet per company, shared by the whole hiring team.
/// Owned by exactly one company (recruiter team) or one user (seeker); enforced by a CHECK.
model CreditWallet {
  id        String   @id @default(uuid())
  companyId String?  @unique
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId    String?  @unique
  user      User?    @relation("UserCreditWallet", fields: [userId], references: [id], onDelete: Cascade)
  balance   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Append-only ledger: every balance change, with the balance right after it.
model CreditTransaction {
  id           String                @id @default(uuid())
  companyId    String?
  company      Company?              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId       String?
  user         User?                 @relation("UserCreditTransactions", fields: [userId], references: [id], onDelete: Cascade)
  amount       Int // positive = credit, negative = debit
  type         CreditTransactionType
  balanceAfter Int
  referenceId  String? // job id, application id, payment id …
  actorId      String?
  note         String?
  createdAt    DateTime              @default(now())

  @@index([companyId, createdAt])
  @@index([userId, createdAt])
  @@index([type, referenceId])
  @@index([createdAt])
}

enum CreditAudience {
  RECRUITER
  SEEKER
}

model CreditPackage {
  id            String         @id @default(uuid())
  code          String         @unique
  name          String
  audience      CreditAudience @default(RECRUITER)
  credits       Int
  bonusCredits  Int       @default(0)
  priceUsdCents Int
  priceEtbCents Int
  active        Boolean   @default(true)
  sortOrder     Int       @default(0)
  payments      Payment[]
}

model Plan {
  id             String  @id @default(uuid())
  code           String  @unique // STARTER | PRO | ENTERPRISE
  name           String
  monthlyCredits Int     @default(0)
  seatLimit      Int? // null = unlimited
  priceUsdCents  Int     @default(0) // per month; 0 = free
  active         Boolean @default(true)
  sortOrder      Int     @default(0)
}

enum EmbeddingKind {
  JOB
  PROFILE
}

/// Semantic vectors for "For you" matching. Plain float arrays (no pgvector needed);
/// similarity is computed in the app over the active-job set.
model Embedding {
  id          String        @id @default(uuid())
  kind        EmbeddingKind
  refId       String // Job.id or Profile.userId
  model       String
  contentHash String
  vector      Float[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([kind, refId])
}
