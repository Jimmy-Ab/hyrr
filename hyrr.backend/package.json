{
  "name": "hyrr.backend",
  "version": "0.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "node --env-file=.env ../node_modules/.bin/nest start --watch",
    "start:prod": "node dist/main",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init",
    "prisma:deploy": "prisma migrate deploy",
    "seed": "node prisma/seed-runner.js",
    "seed:prod": "node dist/prisma/seed.js",
    "test": "jest",
    "build:seed": "tsc prisma/seed.ts --outDir dist/prisma --module commonjs --target es2021 --esModuleInterop --skipLibCheck"
  },
  "prisma": {
    "seed": "node prisma/seed-runner.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
